rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // CVs and resumes
    match /resumes/{userId}/{fileName} {
      allow write: if request.resource.size < 15 * 1024 * 1024;
      allow read: if true;
    }
    // Company legal verification documents (Commercial Register, Tax Card, Logo)
    match /companies/{companyId}/{fileName} {
      allow write: if request.resource.size < 20 * 1024 * 1024;
      allow read: if true;
    }
    // General fallback
    match /{allPaths=**} {
      allow read, write: if true;
    }
  }
}
