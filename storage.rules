rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /resumes/{userId}/{fileName} {
      // Anyone can upload their CV up to 10MB
      allow write: if request.resource.size < 10 * 1024 * 1024;
      // Recruiters and candidates can view CV files
      allow read: if true;
    }
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
